// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(255)
  description String?
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  orderIndex  Int          @map("order_index")
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, orderIndex], map: "idx_tasks_status_order")
  @@index([priority], map: "idx_tasks_priority")
  @@map("tasks")
}

// Copia de una tarea DONE archivada: conserva el UUID original y no se
// restaura al tablero. `id` y `updatedAt` se copian tal cual (sin default).
model ArchivedTask {
  id          String    @id @db.Uuid
  title       String    @db.VarChar(255)
  description String?
  createdAt   DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime  @default(now()) @map("archived_at") @db.Timestamptz(6)

  @@index([archivedAt(sort: Desc)], map: "idx_archived_tasks_archived_at")
  @@map("archived_tasks")
}
